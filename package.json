{
  "name": "pomorodo-desktop",
  "productName": "Pomorodo Desktop",
  "author": "Muhammad Abbas Jhanjhi", 
  "private": true,
  "description": "A compact, easy to install pomorodo app to keep you productive and your work streamlined.",
  "main": "public/electron.cjs",
  "homepage": ".",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron": "electron public/electron.cjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --publish never"
  },
  "keywords": ["desktop-app", "electron-app", "pomorodo", "productivity", "typescript", "typescript-react", "vite"],
  "license": "MIT",
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "build": {
    "directories": { "output": "release" },
    "appId": "com.abbasjhanjhi010.PomorodoDesktop",
    "files": ["dist/**/*", "public/electron.cjs", "public/preload.cjs", "package.json"],
    "mac": { "target": "dmg", "icon": "build/icon.icns", "artifactName": "Pomorodo Desktop.dmg" },
    "win": { "target": "nsis", "icon": "build/icon.ico", "artifactName": "Pomorodo Desktop Setup.exe" }
  }
}
